{
  "redirects": [
    { "source": "/AGENTS.md", "destination": "/404.html", "statusCode": 404 },
    { "source": "/seo-action-plan.zh-CN.md", "destination": "/404.html", "statusCode": 404 },
    { "source": "/(.*).zh-CN.md", "destination": "/404.html", "statusCode": 404 },
    { "source": "/.codex/:path*", "destination": "/404.html", "statusCode": 404 },
    { "source": "/supabase/:path*", "destination": "/404.html", "statusCode": 404 },
    { "source": "/tools/:path*", "destination": "/404.html", "statusCode": 404 },
    { "source": "/.git/:path*", "destination": "/404.html", "statusCode": 404 }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, s-maxage=86400, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=14400, must-revalidate"
        }
      ]
    },
    {
      "source": "/public/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=14400, must-revalidate"
        }
      ]
    }
  ]
}