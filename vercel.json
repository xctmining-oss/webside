{
  "routes": [
    {
      "src": "/AGENTS\\.md",
      "dest": "/404.html",
      "status": 404
    },
    {
      "src": "/seo-action-plan\\.zh-CN\\.md",
      "dest": "/404.html",
      "status": 404
    },
    {
      "src": "/.*\\.zh-CN\\.md",
      "dest": "/404.html",
      "status": 404
    },
    {
      "src": "/\\.codex(?:/.*)?",
      "dest": "/404.html",
      "status": 404
    },
    {
      "src": "/supabase(?:/.*)?",
      "dest": "/404.html",
      "status": 404
    },
    {
      "src": "/tools(?:/.*)?",
      "dest": "/404.html",
      "status": 404
    },
    {
      "src": "/\\.git(?:/.*)?",
      "dest": "/404.html",
      "status": 404
    },
    {
      "handle": "filesystem"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "public, max-age=300, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=14400, must-revalidate"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "public, max-age=14400, must-revalidate"
        }
      ]
    },
    {
      "source": "/public/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=14400, must-revalidate"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "public, max-age=14400, must-revalidate"
        }
      ]
    }
  ]
}
